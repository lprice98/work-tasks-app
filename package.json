{
  "name": "work-tasks",
  "version": "1.0.0",
  "description": "Work task tracker desktop app",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "jest",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^25.0.0",
    "jest": "^29.0.0",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "com.lprice.worktasks",
    "productName": "Work Tasks",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "src/**/*",
      "build/icon.ico"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "lprice98",
      "repo": "work-tasks-app"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "xlsx": "^0.18.5"
  }
}
